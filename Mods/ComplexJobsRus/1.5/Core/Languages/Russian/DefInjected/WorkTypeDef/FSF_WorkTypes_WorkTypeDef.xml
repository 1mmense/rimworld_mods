<!-- EN: Nurse -->
<FSFNurse.labelShort>медработник</FSFNurse.labelShort>
<!-- EN: Nurse -->
<FSFNurse.pawnLabel>Медработник</FSFNurse.pawnLabel>
<!-- EN: Nursing -->
<FSFNurse.gerundLabel>Заботиться</FSFNurse.gerundLabel>
<!-- EN: Care for the sick, bring them food, cheer them up, and perform assigned duties. Nurses will care for colonists, prisoners and animals. -->
<FSFNurse.description>Ухаживают за больными, кормят их, подбадривают, и выполняют поставленные задачи. Медработники ухаживают за поселенцами, пленниками и животными.</FSFNurse.description>
<!-- EN: Care for -->
<FSFNurse.verb>Позаботиться о</FSFNurse.verb>
<!-- EN: Surgeon -->
<FSFSurgeon.labelShort>хирург</FSFSurgeon.labelShort>
<!-- EN: Surgeon -->
<FSFSurgeon.pawnLabel>Хирург</FSFSurgeon.pawnLabel>
<!-- EN: Operating -->
<FSFSurgeon.gerundLabel>Оперировать</FSFSurgeon.gerundLabel>
<!-- EN: Perform surgeries on colonists, prisoners and animals. -->
<FSFSurgeon.description>Проводят операции на колонистах, пленниках и животных.</FSFSurgeon.description>
<!-- EN: Operate on -->
<FSFSurgeon.verb>провести медпроцедуру</FSFSurgeon.verb>
<!-- EN: Rearm -->
