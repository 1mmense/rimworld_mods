<!-- ======================================================= Plant_TreeOak ======================================================= -->
	<EffecterDef>
		<defName>ARYASC_TreeOak_EffectFall</defName>
		<children>
			<li>
				<subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
				<fleckDef>ARYASC_TreeOak_Fleck</fleckDef>
				<burstCount>1</burstCount>
				<spawnLocType>OnSource</spawnLocType>
				<scale>1</scale>
				<rotation>0</rotation>
				<rotationRate>90</rotationRate>
				<absoluteAngle>True</absoluteAngle>
				<positionOffset>(0, 0, .75)</positionOffset>
				<positionRadiusMin>.0</positionRadiusMin>
				<positionRadius>.0</positionRadius>
				<angle>130</angle>
				<fleckUsesAngleForVelocity>True</fleckUsesAngleForVelocity>
				<speed>1.5</speed>
			</li>
		</children>
	</EffecterDef>
	<!-- ======================================================= FLECKS ======================================================= -->
	<FleckDef ParentName="FleckBase_Thrown">
		<defName>ARYASC_TreeOak_Fleck</defName>
		<graphicData>
			<texPath>Things/Plant/TreeOak_Leafless/TreeOak_LeaflessA</texPath>
			<shaderType>Mote</shaderType>
			<graphicClass>Graphic_FleckPulse</graphicClass>
			<renderInstanced>true</renderInstanced>
			<color>(1, 1, 1, 1)</color>
			<drawSize>(2, 2)</drawSize>
		</graphicData>
		<altitudeLayer>MoteOverhead</altitudeLayer>
		<fadeInTime>0</fadeInTime>
		<solidTime>0</solidTime>
		<fadeOutTime>1</fadeOutTime>
	</FleckDef>

